<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lynn</groupId>
        <artifactId>nook</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>nook-ai</artifactId>
    <name>nook-ai</name>
    <description>AI 服务：用户私有 Agent（agentscope HarnessAgent，记忆/会话全量入 PG）</description>

    <dependencies>
        <dependency>
            <groupId>com.lynn</groupId>
            <artifactId>nook-starter</artifactId>
        </dependency>

        <!-- agentscope HarnessAgent：ReAct 推理 + 工作区/记忆/会话/压缩 Hook（版本由父 POM dependencyManagement 统一锁） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <!-- OpenAI 兼容模型 provider（2.0 起从 core 拆出）：OpenAIChatModel + DeepSeek 等 compat formatter，
             DeepSeek 走 OpenAI 兼容协议即用此模块 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <!-- agentscope 官方 PostgreSQL 存储：PostgresBaseStore（工作区裸对象）+ PostgresAgentStateStore（会话状态），
             复用 nook-ai 的 DataSource，替代此前手写的 PgBaseStore / StoreBackedSession -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-postgresql</artifactId>
        </dependency>

        <!-- agent 工作区对象存储（RustFS，S3 兼容）：S3Config 直接依赖。
             此前经 agentscope-harness 传递引入，2.0.2 起 harness 不再传递，需显式声明。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- S3Client 同步 HTTP 实现：JDK 自带 HttpURLConnection，最轻量 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
